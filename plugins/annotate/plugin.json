{
  "id": "annotate",
  "title": "批注",
  "description": "为图片、视频和支持公共选区的阅读器创建批注与摘录。",
  "requires": [
    "preview",
    "note"
  ],
  "optional": [
    "image",
    "video",
    "text",
    "pdf"
  ],
  "entries": {
    "blocks": "./blocks.ts",
    "core": "./core.ts",
    "ui": "./ui.tsx"
  },
  "author": "资源管理器项目",
  "version": "1.1.2",
  "apiVersion": 1,
  "coreFeatures": [
    "image-crop-v1",
    "compatible-schemas-v1",
    "data-lifecycle-v1"
  ],
  "catalog": {
    "category": "information",
    "keywords": [
      "摘录",
      "批注",
      "标记",
      "圈选"
    ],
    "usage": "在图片、视频中选择局部，或在文字、PDF、EPUB 等阅读器中选字，创建批注或摘录。"
  },
  "uiFeatures": [
    "content-selection-v1"
  ]
}
