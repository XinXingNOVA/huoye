{
  "formatVersion": 1,
  "id": "reference-library",
  "title": "通用资料与表格库",
  "version": "0.1.6",
  "description": "用表格整理文档、摘录与自定义字段。",
  "packages": [
    "packages/tags.rmplugin",
    "packages/note.rmplugin",
    "packages/fields.rmplugin",
    "packages/table.rmplugin",
    "packages/annotate.rmplugin",
    "packages/file-editing.rmplugin"
  ],
  "presets": [
    {
      "id": "table",
      "recommendedTheme": "reference-desk",
      "title": "通用资料与表格库",
      "description": "以表格打开全部资料，用标签、笔记、批注与自定义字段整理和查阅。",
      "plugins": [
        "preview",
        "text",
        "pdf",
        "image",
        "tags",
        "note",
        "fields",
        "table",
        "annotate",
        "file-editing"
      ],
      "layout": {
        "version": 1,
        "root": {
          "type": "group",
          "id": "main"
        },
        "primary": "main",
        "panels": {
          "sidebar": true,
          "inspector": true
        },
        "panelSizes": {
          "sidebar": 280,
          "inspector": 300
        },
        "sidebars": {
          "version": 4,
          "containers": [
            {
              "id": "host.navigation",
              "side": "left",
              "type": "tabs",
              "views": [
                "host.navigation"
              ],
              "active": "host.navigation"
            },
            {
              "id": "host.context",
              "side": "left",
              "type": "context",
              "views": [],
              "active": "",
              "contexts": {
                "collection": {
                  "tools": [
                    "host.filters"
                  ],
                  "active": "host.filters"
                }
              }
            },
            {
              "id": "host.inspector",
              "side": "right",
              "type": "tabs",
              "views": [
                "host.inspector"
              ],
              "active": "host.inspector"
            }
          ],
          "selected": {
            "left": "host.navigation",
            "right": "host.inspector"
          },
          "hidden": [],
          "weights": {
            "host.navigation": 0.45,
            "host.context": 0.55,
            "host.inspector": 1
          }
        },
        "contents": {
          "main": {
            "items": [
              {
                "kind": "page",
                "type": "collection",
                "target": {
                  "presetId": "all"
                },
                "presentation": {
                  "layout": "table",
                  "options": {}
                }
              }
            ],
            "active": 0
          }
        }
      }
    }
  ],
  "locales": {
    "en": {
      "通用资料与表格库": "Reference Library",
      "用表格整理文档、摘录与自定义字段。": "Organize documents, excerpts, and custom fields in a table.",
      "以表格打开全部资料，用标签、笔记、批注与自定义字段整理和查阅。": "Organize documents in a table with tags, notes, annotations, and custom fields.",
      "预览": "Previews",
      "文字": "Text",
      "PDF": "PDF",
      "图片": "Image",
      "标签基础": "Tags",
      "笔记": "Notes",
      "自定义字段": "Custom fields",
      "表格": "Table",
      "批注": "Annotations",
      "文件编辑": "File editing"
    }
  }
}
