{
  "name": "resource-manager",
  "productName": "活页Huoye",
  "version": "0.2.0",
  "private": true,
  "description": "以数据块为基本对象的素材管理器",
  "main": "out/main/index.js",
  "scripts": {
    "release:plugins": "node scripts/release/optional-plugins.mjs",
    "release:source": "node scripts/release/source.mjs",
    "test:source-release": "node --test tests/release/source.test.mjs",
    "dev": "node scripts/develop.mjs dev",
    "build": "electron-vite build",
    "start": "node scripts/develop.mjs preview",
    "typecheck": "npm run plugins:generate && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "storage:audit": "node scripts/storage/audit.ts",
    "bench": "BENCH=1 vitest run tests/core/bench.test.ts",
    "plugins:generate": "node scripts/plugins/generate.ts",
    "plugins:check": "node scripts/plugins/generate.ts --check",
    "plugin:dev": "node scripts/plugins/dev.ts",
    "plugin:pack": "node scripts/plugins/pack.ts",
    "suite:pack": "node scripts/plugins/suite.mjs",
    "plugins:pack": "node scripts/plugins/build-bundled.ts",
    "media:prepare": "node scripts/release/prepare-media.mjs",
    "test:portable": "vitest run tests/integration/platform.test.ts tests/integration/lib-protocol.test.ts tests/plugins/rename.test.ts tests/integration/application-access.test.ts tests/integration/plugin-packages.test.ts",
    "pack:mac:test": "npm run licenses:prepare && npm run build && node scripts/release/package-mac.mjs --dir",
    "dist:mac": "npm run licenses:prepare && npm run build && node scripts/release/package-mac.mjs --arm64",
    "dist:win": "npm run media:prepare && npm run licenses:prepare && npm run build && electron-builder --config electron-builder.config.cjs --win --x64 --publish never && node scripts/release/release-notes.mjs",
    "smoke:packaged": "node scripts/release/smoke-packaged.mjs",
    "bench:app": "node scripts/performance/run.mjs",
    "test:plugins": "node scripts/plugins/test.mjs",
    "typecheck:plugins": "node scripts/plugins/test.mjs types",
    "trial:windows": "node scripts/release/build-trial.mjs windows",
    "trial:prepare": "node scripts/release/build-trial.mjs prepare",
    "test:trial-release": "node --test tests/release/trial.test.mjs",
    "licenses:prepare": "node scripts/release/prepare-notices.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@napi-rs/canvas": "1.0.9",
    "@xmldom/xmldom": "0.8.15",
    "better-sqlite3": "^13.0.3",
    "pdfjs-dist": "6.3.289",
    "sharp": "^0.35.5",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@mdit/plugin-tex": "1.1.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "fflate": "0.8.3",
    "katex": "0.18.9",
    "markdown-it": "15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "license": "Apache-2.0"
}
